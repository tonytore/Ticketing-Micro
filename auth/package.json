{
  "name": "auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx prisma db push && nodemon src/index.ts",
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset --force && npm run prisma:push",
    "postinstall": "npx prisma generate || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-session": "^2.0.49",
    "bcrypt": "^6.0.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.5.4"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
